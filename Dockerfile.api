# Nigran 360 API (FastAPI) container for cloud hosting (e.g. Render free web service).
# The camera/microphone proctoring engine is not started in the cloud; browser-side
# monitoring signals are still accepted by this API.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    API_HOST=0.0.0.0 \
    APP_ENV=production

# Microsoft ODBC Driver 18 for SQL Server, plus native libs needed by locked wheels
# (opencv, sounddevice) so imports never crash in a headless container.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gnupg2 ca-certificates unixodbc libgl1 libglib2.0-0 libportaudio2 \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.lock.txt ./
RUN pip install --require-hashes -r requirements.lock.txt

COPY . .
RUN mkdir -p logs runtime screenshots reports exports

ENV PROCTORAI_DB_DRIVER="ODBC Driver 18 for SQL Server" \
    PROCTORAI_DB_TRUSTED=false \
    PROCTORAI_DB_ENCRYPT=true

EXPOSE 10000
CMD ["sh", "-c", "uvicorn infrastructure.api.fastapi_app:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips='*'"]
